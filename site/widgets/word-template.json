{
 "type": "AdaptiveCard",
 "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
 "version": "1.5",
 "body": [
  {
   "type": "TextBlock",
   "text": "📖 Word of the Day",
   "weight": "Bolder",
   "size": "Small"
  },
  {
   "type": "TextBlock",
   "text": "${word}",
   "size": "ExtraLarge",
   "weight": "Bolder",
   "wrap": true
  },
  {
   "type": "TextBlock",
   "text": "${phonetic} · ${partOfSpeech} · ${level}",
   "isSubtle": true,
   "spacing": "None",
   "wrap": true
  },
  {
   "type": "TextBlock",
   "text": "${translationAz}",
   "size": "Large",
   "color": "Accent",
   "wrap": true
  },
  {
   "type": "TextBlock",
   "text": "${exampleEn}",
   "wrap": true,
   "isSubtle": true
  }
 ],
 "actions": [
  {
   "type": "Action.Execute",
   "title": "Open app",
   "verb": "open"
  }
 ]
}