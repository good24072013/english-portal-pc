{
 "type": "AdaptiveCard",
 "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
 "version": "1.5",
 "body": [
  {
   "type": "TextBlock",
   "text": "${title}",
   "weight": "Bolder",
   "size": "Small"
  },
  {
   "type": "TextBlock",
   "text": "${tip}",
   "size": "Medium",
   "wrap": true
  }
 ],
 "actions": [
  {
   "type": "Action.Execute",
   "title": "Open app",
   "verb": "open"
  }
 ]
}